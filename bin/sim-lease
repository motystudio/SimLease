#!/bin/bash
# sim-lease — share iOS simulators / Android emulators between Claude Code sessions.
#
# Each session leases a device instead of booting a fresh one. A lease stays alive
# while the owning session's transcript (or a subagent's) keeps changing, and for
# SIM_LEASE_STALE_MIN after each `acquire` (re-running it refreshes the lease);
# idle/released devices are shut down by `sim-lease reap`, which SimBar runs every
# 5 minutes and every `acquire` runs first. A SessionEnd hook calls `release-session`.
#
#   sim-lease acquire ios|android [--name NAME] [--wait SECS]   -> prints UDID / adb serial
#   sim-lease release [ID]          release this session's lease(s) (device kept warm for reuse)
#   sim-lease release-session SID   release every lease of a session (SessionEnd hook)
#   sim-lease reap                  shut down devices nobody is using
#   sim-lease status                show booted devices and their leases
#   sim-lease shutdown-idle         shut down every booted device without a live lease, now
#   sim-lease kill ID               shut down one device now
#   sim-lease pin|unpin ID          keep a device alive: never shut down automatically
#   sim-lease json                  booted devices + leases as JSON (menu bar app)
#   sim-lease config [json]         show the settings (json: effective values, menu bar app)
#   sim-lease config set KEY VALUE  write KEY=VALUE to the config file (exit 2 if invalid)
#   sim-lease config reset [KEY]    remove KEY (default: every setting) from the config file
#   sim-lease version               print the version
#
# Config (env overrides ~/.claude/sim-lease.conf, which only holds SIM_LEASE_*=<integer> lines):
#   SIM_LEASE_MAX_IOS=3 SIM_LEASE_MAX_ANDROID=2   max booted devices per platform (0-10)
#   SIM_LEASE_STALE_MIN=20     lease dies when its session is idle this long (minutes, 1-1440)
#   SIM_LEASE_GRACE_MIN=10     released device is kept warm this long, then shut down
#   SIM_LEASE_ADOPT_UNMANAGED=0  1 = also shut down devices booted outside sim-lease, after
#   SIM_LEASE_UNMANAGED_GRACE_MIN=30   (0 = leave them alone unless a session leases them)
#   SIM_LEASE_BOOT_TIMEOUT_SEC=600   (env only) how long `acquire` waits for a simulator to boot

set -u
SIM_LEASE_VERSION=1.0.0
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"   # GUI apps (SimBar) get a minimal PATH

# --- config: parsed, never sourced -------------------------------------------
CONF="$HOME/.claude/sim-lease.conf"
CONF_KEYS="SIM_LEASE_MAX_IOS SIM_LEASE_MAX_ANDROID SIM_LEASE_STALE_MIN SIM_LEASE_GRACE_MIN SIM_LEASE_ADOPT_UNMANAGED SIM_LEASE_UNMANAGED_GRACE_MIN"
conf_default() {
  case "$1" in
    SIM_LEASE_MAX_IOS) echo 3;; SIM_LEASE_MAX_ANDROID) echo 2;; SIM_LEASE_STALE_MIN) echo 20;;
    SIM_LEASE_GRACE_MIN) echo 10;; SIM_LEASE_ADOPT_UNMANAGED) echo 0;; SIM_LEASE_UNMANAGED_GRACE_MIN) echo 30;;
    *) return 1;;
  esac
}
conf_valid() { # key value -> 0 if allowed, with the normalized value in CV
  CV=""
  [[ "$2" =~ ^[0-9]{1,5}$ ]] || return 1
  local v=$((10#$2))
  case "$1" in
    SIM_LEASE_MAX_IOS|SIM_LEASE_MAX_ANDROID) [ "$v" -le 10 ] || return 1;;
    SIM_LEASE_ADOPT_UNMANAGED) [ "$v" -le 1 ] || return 1;;
    SIM_LEASE_STALE_MIN|SIM_LEASE_GRACE_MIN|SIM_LEASE_UNMANAGED_GRACE_MIN) [ "$v" -ge 1 ] && [ "$v" -le 1440 ] || return 1;;
    *) return 1;;
  esac
  CV=$v
}
conf_load() { # effective value of every key into $KEY, file value into FILE_KEY, origin (env|file|default) into SRC_KEY
  local k v e
  for k in $CONF_KEYS; do printf -v "FILE_$k" '%s' ""; done
  while IFS='=' read -r k v; do   # last valid assignment in the file wins
    conf_valid "$k" "$v" && printf -v "FILE_$k" '%s' "$CV"
  done < <(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?(SIM_LEASE_[A-Z_]+)=([0-9]+)[[:space:]]*(#.*)?$/\2=\3/p' "$CONF" 2>/dev/null)
  for k in $CONF_KEYS; do
    v=$(conf_default "$k"); printf -v "SRC_$k" '%s' default
    e="FILE_$k"; [ -n "${!e}" ] && { v=${!e}; printf -v "SRC_$k" '%s' file; }
    e=${!k:-}
    if [ -n "$e" ]; then
      if conf_valid "$k" "$e"; then v=$CV; printf -v "SRC_$k" '%s' env
      else echo "sim-lease: ignoring invalid $k=$e from the environment" >&2; fi
    fi
    printf -v "$k" '%s' "$v"
  done
}
conf_load
MAX_IOS=$SIM_LEASE_MAX_IOS
MAX_ANDROID=$SIM_LEASE_MAX_ANDROID
STALE_MIN=$SIM_LEASE_STALE_MIN
GRACE_MIN=$SIM_LEASE_GRACE_MIN
ADOPT=$SIM_LEASE_ADOPT_UNMANAGED
UNMANAGED_GRACE_MIN=$SIM_LEASE_UNMANAGED_GRACE_MIN
BOOT_TIMEOUT=${SIM_LEASE_BOOT_TIMEOUT_SEC:-600}; [[ "$BOOT_TIMEOUT" =~ ^[0-9]+$ ]] || BOOT_TIMEOUT=600

DIR="$HOME/.claude/sim-leases"
LOCK="$DIR/.lock"
LOG="$DIR/sim-lease.log"
for ANDROID_SDK in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}" "$HOME/Library/Android/sdk" /opt/homebrew/share/android-commandlinetools /usr/local/share/android-commandlinetools; do
  [ -n "$ANDROID_SDK" ] && [ -d "$ANDROID_SDK" ] && break
done
ADB="$ANDROID_SDK/platform-tools/adb"; [ -x "$ADB" ] || ADB=$(command -v adb || true)
EMULATOR="$ANDROID_SDK/emulator/emulator"; [ -x "$EMULATOR" ] || EMULATOR=$(command -v emulator || true)
JQ=/usr/bin/jq; [ -x "$JQ" ] || JQ=$(command -v jq || true)
SID="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
HOST_SID="${CLAUDE_CODE_HOST_SESSION_ID:-}"   # desktop app session (local_…), used to jump to it
mkdir -p "$DIR"

now() { date +%s; }
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
die() { echo "sim-lease: $1" >&2; exit "${2:-1}"; }   # message [exit code]
drop() { local f="${DIR:?}/${1:?}"; rm -f "$f"; }
need_jq() { [ -n "$JQ" ] || die "jq not found (macOS 15+ ships /usr/bin/jq; otherwise: brew install jq)"; }
# xcrun is never run unless a full Xcode is selected: on a Mac without developer tools it
# pops the install dialog (SimBar polls every 15 s). No Xcode = no iOS, silently.
HAS_SIMCTL=""
has_simctl() {
  if [ -z "$HAS_SIMCTL" ]; then
    local d; d=${DEVELOPER_DIR:-$(xcode-select -p 2>/dev/null)}; HAS_SIMCTL=0
    [ -n "$d" ] && [ -d "$d" ] && { [ -d "$d/Platforms/iPhoneSimulator.platform" ] || xcrun -f simctl >/dev/null 2>&1; } && HAS_SIMCTL=1
  fi
  [ "$HAS_SIMCTL" = 1 ]
}
need_simctl() { has_simctl || die "xcrun simctl not available: install Xcode, open it once, then run: sudo xcode-select -s /Applications/Xcode.app"; }
need_adb() { [ -n "$ADB" ] || die "adb not found: install the Android SDK platform-tools, or set ANDROID_HOME"; }

# $LOCK/pid holds the holder's PID. A lock is broken only when that process is gone (boots
# hold it for minutes), or, without a PID file (killed right after mkdir), after 10 min.
try_lock() { mkdir "$LOCK" 2>/dev/null || return 1; echo $$ > "$LOCK/pid"; trap unlock EXIT; }
lock() {
  local i=0 pid
  until try_lock; do
    pid=$(cat "$LOCK/pid" 2>/dev/null)
    if { [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; } ||
       { [ -z "$pid" ] && [ $(( $(now) - $(stat -f %m "$LOCK" 2>/dev/null || now) )) -gt 600 ]; }; then
      if mv "$LOCK" "$LOCK.$$" 2>/dev/null; then   # rename first so two waiters can't both break it
        [ "$(cat "$LOCK.$$/pid" 2>/dev/null)" = "$pid" ] || [ -e "$LOCK" ] || mv "$LOCK.$$" "$LOCK"   # raced: give it back
        rm -f "$LOCK.$$/pid"; rmdir "$LOCK.$$" 2>/dev/null; log "broke stale lock (pid ${pid:-none})"
      fi
      continue
    fi
    i=$((i+1)); [ $i -gt 900 ] && die "lock timeout"
    sleep 1
  done
}
unlock() { [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ] && { rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null; }; trap - EXIT; }

# --- lease files: $DIR/<id>, key=value lines -------------------------------
lget() { grep -m1 "^$2=" "$DIR/$1" 2>/dev/null | cut -d= -f2-; }
lwrite() { # id platform name session released_at [host_session]
  printf 'platform=%s\nname=%s\nsession=%s\nsince=%s\nreleased_at=%s\nhost=%s\n' "$2" "$3" "$4" "$(now)" "$5" "${6:-}" > "$DIR/$1"
}
leases() { ls "$DIR" 2>/dev/null | grep -v -e '^\.' -e '\.log$' -e '\.err$'; }

# pinned devices are never shut down automatically (iOS: UDID, Android: AVD name,
# since an emulator's serial changes on every boot)
PINS="$DIR/.pinned"
pin_key() { if [ "$2" = ios ]; then echo "$1"; else echo "${3:-$(lget "$1" name)}"; fi; }   # id platform [name]
pinned() { [ -f "$PINS" ] && grep -qxF "$(pin_key "$@")" "$PINS"; }

# last activity of a session = newest mtime of its transcript and of its subagents'
# transcripts (<projects>/<proj>/<sid>/subagents/agent-*.jsonl), 0 if none is found.
# Finding the transcript means globbing every project folder, so its path is cached in
# $DIR/.transcripts (`acquire` primes it, so SimBar also finds transcripts under a
# CLAUDE_CONFIG_DIR it doesn't know).
TRANSCRIPTS="$DIR/.transcripts"
session_last_active() {
  local f t
  f=$(awk -v s="$1" '$1==s {print substr($0, length(s)+2); exit}' "$TRANSCRIPTS" 2>/dev/null)
  if [ -z "$f" ] || [ ! -f "$f" ]; then
    f=$(ls "$HOME"/.claude/projects/*/"$1".jsonl ${CLAUDE_CONFIG_DIR:+"$CLAUDE_CONFIG_DIR"/projects/*/"$1".jsonl} 2>/dev/null | head -1)
    [ -n "$f" ] && printf '%s %s\n' "$1" "$f" >> "$TRANSCRIPTS"
  fi
  if [ -n "$f" ]; then t=$(ls -t "$f" "${f%/*/*}"/*/"$1"/subagents/agent-*.jsonl 2>/dev/null | head -1)
  else t=$(ls -t "$HOME"/.claude/projects/*/"$1"/subagents/agent-*.jsonl ${CLAUDE_CONFIG_DIR:+"$CLAUDE_CONFIG_DIR"/projects/*/"$1"/subagents/agent-*.jsonl} 2>/dev/null | head -1); fi
  if [ -n "$t" ]; then stat -f %m "$t"; else echo 0; fi
}
# last activity of a lease = latest of its session's transcripts, its `since` and the lease
# file's mtime (`acquire` touches it), so a lease outlives a missing transcript or a long
# tool call by STALE_MIN after the last acquire
lease_last_active() {
  local t a b; t=$(session_last_active "$(lget "$1" session)"); a=$(lget "$1" since)
  b=$(stat -f %m "$DIR/$1" 2>/dev/null || echo 0); [[ "$a" =~ ^[0-9]+$ ]] || a=0
  [ "$a" -gt "$t" ] && t=$a; [ "$b" -gt "$t" ] && t=$b; echo "$t"
}
lease_live() { # id -> 0 if held by an active session
  case "$(lget "$1" session)" in ""|none|unmanaged) return 1;; esac
  [ $(( $(now) - $(lease_last_active "$1") )) -lt $((STALE_MIN*60)) ]
}
# a lease applies to the device booted under its id only if the device's name still matches:
# an emulator serial (emulator-5554) is reused by whatever AVD next runs on that port
lease_matches() { # id current_name
  local n; [ -f "$DIR/$1" ] || return 1; n=$(lget "$1" name)
  [ -z "$n" ] || [ -z "$2" ] || [ "$n" = "$2" ]
}

# --- devices -----------------------------------------------------------------
# both listings fail (rather than print nothing) when the platform can't be queried,
# so reap doesn't take "simctl/adb unavailable" for "every device is shut down"
ios_booted() { # "udid<TAB>name"  (nothing when Xcode isn't installed)
  has_simctl || return 0
  local j; j=$(xcrun simctl list devices booted -j 2>/dev/null) && [ -n "$JQ" ] || return 1
  printf '%s' "$j" | "$JQ" -r '.devices[][] | select(.state=="Booted") | "\(.udid)\t\(.name)"'
}
android_booted() { # "serial<TAB>avd"  (emulators only, physical devices are never touched)
  local d; [ -n "$ADB" ] && d=$("$ADB" devices 2>/dev/null) || return 1
  echo "$d" | awk '$1 ~ /^emulator-/ && $2=="device" {print $1}' | while read -r s; do
    printf '%s\t%s\n' "$s" "$("$ADB" -s "$s" emu avd name 2>/dev/null | head -1 | tr -d '\r')"
  done
}
booted() { if [ "$1" = ios ]; then ios_booted; else android_booted; fi; }
scan() { # snapshot of the booted devices into LIST_ios / LIST_android; OK_<p>=0 if <p> can't be queried
  has_simctl   # cached for the subshells below
  OK_ios=1; LIST_ios=$(ios_booted) || OK_ios=0
  OK_android=1; LIST_android=$(android_booted) || OK_android=0
}
prune() { # (after scan, under the lock) drop leases of devices that are gone or now run another device
  local id p ok list line
  for id in $(leases); do
    p=$(lget "$id" platform); [ "$p" = ios ] || p=android
    ok="OK_$p"; list="LIST_$p"; [ "${!ok}" = 1 ] || continue
    line=$(printf '%s\n' "${!list}" | awk -F'\t' -v i="$id" '$1==i {print "+" $2; exit}')
    if [ -z "$line" ]; then drop "$id"   # already shut down
    elif ! lease_matches "$id" "${line#+}"; then log "drop stale lease $p $id ($(lget "$id" name), now runs ${line#+})"; drop "$id"; fi
  done
}
shutdown_dev() { # id platform  (keeps the lease if the device didn't actually stop)
  local ok=0
  if [ "$2" = ios ]; then xcrun simctl shutdown "$1" >/dev/null 2>&1 || ok=$?
  elif [ -n "$ADB" ]; then "$ADB" -s "$1" emu kill >/dev/null 2>&1 || ok=$?
  else ok=127; fi
  if [ "$ok" -ne 0 ]; then log "shutdown FAILED $2 $1 (exit $ok)"; return 1; fi
  drop "$1"; log "shutdown $2 $1"
}

ios_pick() { # [name|udid] -> udid of the shutdown simulator to boot (newest iOS, Pro first), or nothing
  xcrun simctl list devices available -j 2>/dev/null | "$JQ" -r --arg w "${1:-}" '
    .devices | to_entries | map(select(.key|test("iOS-")))
    | sort_by(.key|capture("iOS-(?<a>[0-9]+)-(?<b>[0-9]+)")|[(.a|tonumber),(.b|tonumber)]) | reverse
    | [.[].value[] | select(.state=="Shutdown")
       | select(if $w=="" then (.name|test("^iPhone")) else (.name==$w or .udid==$w) end)]
    | (map(select(.name|test("Pro$"))) + .) | .[0].udid // empty'
}
boot_ios() { # [name|udid] -> udid
  local want="${1:-}" udid pid i
  udid=$(ios_pick "$want")
  [ -n "$udid" ] || die "no shutdown iOS simulator matching '${want:-iPhone}' (add one in Xcode > Window > Devices and Simulators)"
  xcrun simctl boot "$udid" >/dev/null 2>&1 || ios_booted | cut -f1 | grep -qx "$udid" || die "could not boot simulator $udid"
  # bootstatus has no timeout (a first boot after an Xcode update can take 10+ min) and we hold the lock
  xcrun simctl bootstatus "$udid" -b >/dev/null 2>&1 & pid=$!
  for ((i = 0; i < BOOT_TIMEOUT; i++)); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
  if kill -0 "$pid" 2>/dev/null; then
    pkill -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null; log "boot timeout ios $udid"
    die "simulator $udid did not finish booting in $((BOOT_TIMEOUT / 60)) min; it may still be booting: run acquire again in a few minutes"
  fi
  echo "$udid"
}
boot_android() { # [avd] -> serial
  local want="${1:-}" running avd="" a before s i
  [ -n "$EMULATOR" ] || die "Android emulator not found: install it with the Android SDK, or set ANDROID_HOME"
  need_adb
  running=$(android_booted | cut -f2)
  for a in $("$EMULATOR" -list-avds 2>/dev/null | grep -v '^INFO'); do
    echo "$running" | grep -qx "$a" && continue
    if [ -z "$want" ] || [ "$a" = "$want" ]; then avd="$a"; break; fi
  done
  [ -n "$avd" ] || die "no free AVD matching '${want:-any}'"
  before=$("$ADB" devices | awk '/^emulator-/{print $1}')
  nohup "$EMULATOR" -avd "$avd" -no-snapshot-save -no-boot-anim >/dev/null 2>&1 &
  for i in $(seq 1 240); do
    sleep 1
    for s in $("$ADB" devices | awk '/^emulator-/{print $1}'); do
      echo "$before" | grep -qx "$s" && continue
      [ "$("$ADB" -s "$s" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && { echo "$s"; return; }
    done
  done
  die "emulator $avd did not finish booting in 4 min"
}

# --- commands ----------------------------------------------------------------
reap() { # (under the lock)
  local id p s idle_since grace ok list name gone=" "
  scan; prune
  for id in $(leases); do
    p=$(lget "$id" platform); [ "$p" = ios ] || p=android
    ok="OK_$p"; [ "${!ok}" = 1 ] || continue
    lease_live "$id" && continue
    pinned "$id" "$p" && continue
    s=$(lget "$id" session)
    case "$s" in
      none)      idle_since=$(lget "$id" released_at); grace=$GRACE_MIN ;;
      unmanaged) [ "$ADOPT" = 1 ] || { drop "$id"; continue; }   # adoption turned off: leave it alone
                 idle_since=$(lget "$id" released_at); grace=$UNMANAGED_GRACE_MIN ;;
      *)         idle_since=$(( $(lease_last_active "$id") + STALE_MIN*60 )); grace=$GRACE_MIN ;;
    esac
    [ $(( $(now) - ${idle_since:-0} )) -ge $((grace*60)) ] && shutdown_dev "$id" "$p" && gone="$gone $id "
  done
  for p in ios android; do   # keep the snapshot current for acquire (an emulator dies asynchronously)
    list="LIST_$p"; [ "$gone" = " " ] || printf -v "$list" '%s' "$(printf '%s\n' "${!list}" | awk -F'\t' -v g="$gone" 'index(g, " " $1 " ") == 0')"
  done
  [ "$ADOPT" = 1 ] || return 0
  for p in ios android; do
    list="LIST_$p"
    while IFS=$'\t' read -r id name; do
      [ -n "$id" ] && [ ! -f "$DIR/$id" ] || continue
      lwrite "$id" "$p" "$name" unmanaged "$(now)"; log "adopt $p $id ($name)"
    done <<< "${!list}"
  done
}

acquire() {
  local p="${1:-}" want="" wait=0 id name n max deadline list held
  shift || true
  [ "$p" = ios ] || [ "$p" = android ] || die "usage: sim-lease acquire ios|android [--name NAME] [--wait SECS]"
  while [ $# -gt 0 ]; do case "$1" in
    --name) [ -n "${2:-}" ] || die "--name needs a value"; want="$2"; shift 2;;
    --wait) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--wait needs a number of seconds"; wait="$2"; shift 2;;
    *) die "unknown arg $1";;
  esac; done
  [ -n "$SID" ] || die "CLAUDE_CODE_SESSION_ID not set; run from a Claude Code session"
  [ "$p" = ios ] && need_simctl
  # caches this session's transcript path; without one the lease lives only on acquire calls
  if [ "$(session_last_active "$SID")" = 0 ] && ! grep -qxF "$SID" "$DIR/.warned" 2>/dev/null; then
    echo "$SID" >> "$DIR/.warned"
    echo "sim-lease: warning: this session's transcript wasn't found under ~/.claude/projects; run acquire again at least every $STALE_MIN min to keep the lease alive" >&2
  fi
  max=$MAX_IOS; [ "$p" = android ] && max=$MAX_ANDROID
  deadline=$(( $(now) + wait ))
  while :; do
    lock; reap
    # 1. this session already holds one: refresh the lease
    for id in $(leases); do
      [ "$(lget "$id" platform)" = "$p" ] && [ "$(lget "$id" session)" = "$SID" ] || continue
      [ -z "$want" ] || [ "$(lget "$id" name)" = "$want" ] || [ "$id" = "$want" ] || continue
      touch "$DIR/$id"; echo "$id"; return 0
    done
    # 2. a booted device nobody is using (a named one held by a live session is busy)
    list="LIST_$p"; held=0
    while IFS=$'\t' read -r id name; do
      [ -n "$id" ] || continue
      [ -z "$want" ] || [ "$name" = "$want" ] || [ "$id" = "$want" ] || continue
      lease_live "$id" && { [ -n "$want" ] && held=1; continue; }
      lwrite "$id" "$p" "$name" "$SID" "" "$HOST_SID"; log "lease $p $id ($name) -> $SID (reused)"
      echo "$id"; return 0
    done <<< "${!list}"
    # 3. boot a new one if under the cap, unless the named device is busy (an AVD runs once;
    #    an iOS name can still match another, shutdown simulator)
    [ "$held" = 1 ] && [ "$p" = ios ] && [ -n "$(ios_pick "$want")" ] && held=0
    n=$(printf '%s\n' "${!list}" | grep -c .)
    if [ "$held" = 0 ] && [ "$n" -lt "$max" ]; then
      if [ "$p" = ios ]; then id=$(boot_ios "$want") || exit 1
      else id=$(boot_android "$want") || exit 1; fi
      name=$(booted "$p" | awk -F'\t' -v u="$id" '$1==u{print $2}')
      lwrite "$id" "$p" "$name" "$SID" "" "$HOST_SID"; log "lease $p $id ($name) -> $SID (booted)"
      echo "$id"; return 0
    fi
    unlock
    if [ "$(now)" -ge "$deadline" ]; then
      if [ "$held" = 1 ]; then
        echo "sim-lease: $want is in use by another session:" >&2; status >&2
        echo "Retry with --wait 300, or acquire without --name." >&2
      else
        echo "sim-lease: all $max $p devices are in use by other sessions:" >&2; status >&2
        echo "Retry with --wait 300, or ask the user to raise SIM_LEASE_MAX_$(echo "$p" | tr a-z A-Z)." >&2
      fi
      exit 3
    fi
    sleep 10
  done
}

release() { # [id] [session]  (device stays booted GRACE_MIN so the next session can reuse it)
  local id s="${2:-$SID}"
  [ -n "$s" ] || die "no session id"
  lock
  for id in $(leases); do
    [ "$(lget "$id" session)" = "$s" ] || continue
    [ -z "${1:-}" ] || [ "$id" = "$1" ] || continue
    lwrite "$id" "$(lget "$id" platform)" "$(lget "$id" name)" none "$(now)"; log "release $id from $s"
    echo "released $id"
  done
}

status() {
  local p id name s ra info list
  scan
  for p in ios android; do
    list="LIST_$p"
    while IFS=$'\t' read -r id name; do
      [ -n "$id" ] || continue
      s=""; lease_matches "$id" "$name" && s=$(lget "$id" session)   # else: stale lease of another device
      if [ -n "$s" ] && lease_live "$id"; then info="leased by $s (active $(( ($(now) - $(lease_last_active "$id"))/60 )) min ago)"
      elif [ -z "$s" ]; then info="no lease"
      else ra=$(lget "$id" released_at); info="idle ($s) since $(( ($(now) - ${ra:-$(now)})/60 )) min"; fi
      printf '%-8s %-38s %-26s %s\n' "$p" "$id" "$name" "$info"
    done <<< "${!list}"
  done
}

# one JSON object per booted device, for the menu bar app. Also drops leases of devices that
# are gone or replaced, unless another command holds the lock (never waits for it).
json() {
  local p id name s live last ra grace left pin host list
  if try_lock; then scan; prune; unlock; else scan; fi
  for p in ios android; do
    list="LIST_$p"
    while IFS=$'\t' read -r id name; do
      [ -n "$id" ] || continue
      s=""; ra=""; host=""; last=0; left=-1
      lease_matches "$id" "$name" && { s=$(lget "$id" session); ra=$(lget "$id" released_at); host=$(lget "$id" host); }
      if pinned "$id" "$p" "$name"; then pin=true; else pin=false; fi
      case "$s" in ""|none|unmanaged) ;; *) last=$(lease_last_active "$id") ;; esac
      if [ -n "$s" ] && lease_live "$id"; then live=true; else
        live=false
        case "$s" in
          "")        ;;
          none)      grace=$GRACE_MIN; left=$(( (${ra:-0} + grace*60 - $(now)) / 60 )) ;;
          unmanaged) grace=$UNMANAGED_GRACE_MIN; left=$(( (${ra:-0} + grace*60 - $(now)) / 60 )) ;;
          *)         left=$(( (last + (STALE_MIN+GRACE_MIN)*60 - $(now)) / 60 )) ;;
        esac
        [ "$left" -lt -1 ] && left=0
        [ "$pin" = true ] && left=-1
      fi
      "$JQ" -nc --arg p "$p" --arg id "$id" --arg name "$name" --arg s "$s" --arg host "$host" \
        --argjson live "$live" --argjson last "$last" --argjson left "$left" --argjson pin "$pin" \
        '{platform:$p, id:$id, name:$name, session:$s, host:$host, live:$live, lastActive:$last, shutdownInMin:$left, pinned:$pin}'
    done <<< "${!list}"
  done | "$JQ" -s .
}

pin_dev() { # on|off id
  local id="${2:?usage: sim-lease pin|unpin ID}" p=android name="" key
  echo "$id" | grep -qiE '^[0-9a-f-]{36}$' && { p=ios; id=$(echo "$id" | tr a-f A-F); }
  [ "$p" = android ] && name=$(android_booted | awk -F'\t' -v s="$id" '$1==s{print $2}')
  key=$(pin_key "$id" "$p" "${name:-$id}")   # Android: accepts the serial or the AVD name
  lock; touch "$PINS"
  grep -vxF "$key" "$PINS" > "$PINS.tmp"; mv "$PINS.tmp" "$PINS"
  if [ "$1" = on ]; then echo "$key" >> "$PINS"; log "pin $key"; echo "pinned $key"
  else log "unpin $key"; echo "unpinned $key"; fi
}

kill_dev() { # id — shut down now, whoever holds it
  local id="${1:?usage: sim-lease kill ID}" p=android
  echo "$id" | grep -qiE '^[0-9a-f-]{36}$' && { p=ios; id=$(echo "$id" | tr a-f A-F); }
  if [ "$p" = ios ]; then need_simctl; else need_adb; fi
  lock; shutdown_dev "$id" "$p" || die "could not shut down $id"; echo "shut down $id"
}

shutdown_idle() {
  local p id name
  lock
  for p in ios android; do
    booted "$p" | while IFS=$'\t' read -r id name; do
      [ -n "$id" ] || continue
      { lease_matches "$id" "$name" && lease_live "$id"; } || pinned "$id" "$p" "$name" || shutdown_dev "$id" "$p"
    done
  done
}

conf_write() { # key [value]  rewrite $CONF atomically; no value = remove the key (key "" = every SIM_LEASE_ key)
  local k="$1" v="${2:-}" target="$CONF" src tmp
  [ -L "$CONF" ] && target=$(readlink -f "$CONF")   # a symlinked conf (dotfiles) stays a symlink
  src=$target; [ -f "$src" ] || { [ -n "$v" ] || return 0; src=/dev/null; }
  tmp=$(mktemp "$target.XXXXXX") || die "cannot write $target"
  # the first assignment of the key is replaced in place (keeping a trailing comment), later
  # ones are dropped; comments and every other line are kept as they are
  awk -v k="$k" -v v="$v" '
    BEGIN { re = "^[[:space:]]*(export[[:space:]]+)?" (k == "" ? "SIM_LEASE_[A-Za-z0-9_]*" : k) "=" }
    $0 ~ re {
      if (v != "" && !done) {
        rest = ""
        if ($0 ~ /^[^=]*=[0-9]+[[:space:]]+#/) { rest = substr($0, index($0, "=") + 1); sub(/^[0-9]+/, "", rest) }
        print substr($0, 1, index($0, "=") - 1) "=" v rest; done = 1
      }
      next
    }
    { print }
    END { if (v != "" && !done) print k "=" v }
  ' "$src" > "$tmp" && mv -f "$tmp" "$target" || { rm -f "$tmp"; die "cannot write $target"; }
}

config() {
  local k s f src
  case "${1:-}" in
    "")
      echo "Config file: $CONF$([ -f "$CONF" ] || echo ' (not created yet)')"
      for k in $CONF_KEYS; do
        s="SRC_$k"; f="FILE_$k"
        case "${!s}" in
          file) src="config file";;
          env)  src="environment$([ -z "${!f}" ] || echo ", overrides config file value ${!f}")";;
          *)    src="default";;
        esac
        printf '%-30s %-5s %s\n' "$k" "${!k}" "$src"
      done ;;
    json)
      printf '{"SIM_LEASE_MAX_IOS":%s,"SIM_LEASE_MAX_ANDROID":%s,"SIM_LEASE_STALE_MIN":%s,"SIM_LEASE_GRACE_MIN":%s,"SIM_LEASE_ADOPT_UNMANAGED":%s,"SIM_LEASE_UNMANAGED_GRACE_MIN":%s}\n' \
        "$SIM_LEASE_MAX_IOS" "$SIM_LEASE_MAX_ANDROID" "$SIM_LEASE_STALE_MIN" "$SIM_LEASE_GRACE_MIN" "$SIM_LEASE_ADOPT_UNMANAGED" "$SIM_LEASE_UNMANAGED_GRACE_MIN" ;;
    set)
      [ $# -eq 3 ] || die "usage: sim-lease config set KEY VALUE" 2
      conf_default "$2" >/dev/null || die "unknown key '$2' (one of: $CONF_KEYS)" 2
      conf_valid "$2" "$3" || case "$2" in
        *_MAX_*)   die "$2 must be an integer from 0 to 10" 2;;
        *_ADOPT_*) die "$2 must be 0 or 1" 2;;
        *)         die "$2 must be an integer from 1 to 1440 (minutes)" 2;;
      esac
      lock; conf_write "$2" "$CV"; log "config $2=$CV"; echo "$2=$CV" ;;
    reset)
      [ $# -le 2 ] || die "usage: sim-lease config reset [KEY]" 2
      [ -z "${2:-}" ] || conf_default "$2" >/dev/null || die "unknown key '$2' (one of: $CONF_KEYS)" 2
      lock; conf_write "${2:-}"; log "config reset ${2:-all}" ;;
    *) die "usage: sim-lease config [json | set KEY VALUE | reset [KEY]]" 2 ;;
  esac
}

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

cmd="${1:-status}"; shift || true
case "$cmd" in acquire|reap|status|json|shutdown-idle) need_jq ;; esac
case "$cmd" in
  acquire) acquire "$@" ;;
  release) release "${1:-}" ;;
  release-session)
    s="${1:-}"; [ -n "$s" ] || [ -z "$JQ" ] || s=$("$JQ" -r '.session_id // empty' 2>/dev/null)
    [ -n "$s" ] && release "" "$s" >/dev/null; exit 0 ;;
  reap) lock; reap ;;
  status) status ;;
  json) json ;;
  kill) kill_dev "${1:-}" ;;
  pin) pin_dev on "${1:-}" ;;
  unpin) pin_dev off "${1:-}" ;;
  shutdown-idle) shutdown_idle ;;
  config) config "$@" ;;
  version|--version|-v) echo "$SIM_LEASE_VERSION" ;;
  help|--help|-h) usage ;;
  *) usage; exit 1 ;;
esac
